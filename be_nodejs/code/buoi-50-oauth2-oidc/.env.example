# ── Nhà cung cấp OIDC ──────────────────────────────────────────────
# Mặc định: nhà cung cấp mini chạy ngay trong repo (cổng 4000) — không cần Internet.
OIDC_ISSUER=http://localhost:4000
OIDC_CLIENT_ID=shop-demo
OIDC_CLIENT_SECRET=bi-mat-chi-server-biet
OIDC_REDIRECT_URI=http://localhost:3000/dang-nhap/oidc/callback

# Muốn thử với Google thật:
#   1. console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#   2. Authorized redirect URI: http://localhost:3000/dang-nhap/oidc/callback
#   3. Đổi 3 dòng dưới, và CHẠY_NHA_CUNG_CAP=0
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=xxxxx.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=GOCSPX-xxxxx
CHAY_NHA_CUNG_CAP=1

CONG_SHOP=3000
CONG_NHA_CUNG_CAP=4000
