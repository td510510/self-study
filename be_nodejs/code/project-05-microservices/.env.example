# Mỗi dịch vụ MỘT database (cùng máy chủ Postgres trong docker-compose)
DB_DON_HANG=postgres://hoc:hoc@localhost:5440/don_hang
DB_KHO=postgres://hoc:hoc@localhost:5440/kho
DB_THONG_BAO=postgres://hoc:hoc@localhost:5440/thong_bao

RABBITMQ_URL=amqp://hoc:hoc@localhost:5673

CONG_DON_HANG=3201
CONG_KHO=3202
CONG_THONG_BAO=3203

# OpenTelemetry gửi trace tới Jaeger (OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Diễn tập sự cố (buổi 55) ──
# Kho chậm thêm N ms mỗi đơn (thấy rõ trong Jaeger)
KHO_DO_TRE_MS=0
# Tỉ lệ (0..1) gửi email lỗi tạm thời
THONG_BAO_TI_LE_LOI=0

LOG_LEVEL=info
