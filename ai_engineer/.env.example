# =============================================================================
#  FILE MAU - copy thanh .env roi dien gia tri that
#      Windows:  copy .env.example .env
#
#  QUAN TRONG: file .env KHONG BAO GIO duoc commit len GitHub.
#  File .gitignore da chan san - dung xoa dong do.
# =============================================================================

# --- Bat buoc tu Tuan 16 (Phase 07 - LLM Engineering) ---
# Lay tai: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-thay-bang-key-that-cua-ban


# =============================================================================
#  MODEL ID - go CHINH XAC nhu duoi day
#
#  LUU Y: KHONG them hau to ngay thang (vi du "-20251001") vao sau ten model.
#  Cac chuoi duoi day da day du, them ngay vao se bi loi model khong ton tai.
# =============================================================================

# RE NHAT - dung cho hau het bai tap trong khoa hoc nay
#   $1.00 / 1 trieu token vao   |   $5.00 / 1 trieu token ra
#   Cua so ngu canh: 200K token
MODEL_RE=claude-haiku-4-5

# CAN BANG - dung khi can chat luong cao hon
#   $3.00 / 1 trieu token vao   |   $15.00 / 1 trieu token ra
#   Cua so ngu canh: 1M token
MODEL_CAN_BANG=claude-sonnet-5

# MANH NHAT - chi dung o bai so sanh chat luong va o capstone
#   $5.00 / 1 trieu token vao   |   $25.00 / 1 trieu token ra
#   Cua so ngu canh: 1M token
MODEL_MANH=claude-opus-5

# Model mac dinh cho cac bai tap (de doi mot cho khi can)
MODEL_MAC_DINH=claude-haiku-4-5


# =============================================================================
#  GIOI HAN AN TOAN (Phase 07+)
#  Chan vong lap goi API vo han lam het tien
# =============================================================================
MAX_TOKENS_MAC_DINH=1024
MAX_CALLS_PER_RUN=20


# --- Tuy chon: Phase 08 (RAG) ---
# CHROMA_PERSIST_DIR=./data/chroma


# =============================================================================
#  PHASE 10 - DEPLOY & VAN HANH
#
#  Day la cac bien ma `doc_cau_hinh()` o Phase 10 doc toi. Ten cua chung
#  NGAN GON hon cac bien o tren vi chung duoc doc bang MOT ham duy nhat luc
#  khoi dong, khong rai rac trong code - do la ca bai hoc cua ex01 Phase 10.
# =============================================================================

# Model ma dich vu se dung. Doc bang bien MODEL (khong phai MODEL_RE).
MODEL=claude-haiku-4-5

# "dev" hoac "prod". Sai gia tri -> ung dung KHONG khoi dong.
MOI_TRUONG=dev

# So token toi da moi lan goi
MAX_TOKEN=1024

# Ngan sach cho ca phien. Vuot qua -> dich vu TU CHOI request, khong chi canh bao.
NGAN_SACH_USD=5.0

# Ghi ca prompt nguoi dung vao log?
#   dev  -> bat duoc, tien cho go loi
#   prod -> BAT BUOC tat. Bat o prod se lam ung dung nem ValueError luc khoi
#           dong, vi prompt chua du lieu ca nhan cua nguoi dung.
GHI_LOG_PROMPT=false

# --- Tuy chon ---
# APP_PORT=8000
# LOG_LEVEL=INFO
